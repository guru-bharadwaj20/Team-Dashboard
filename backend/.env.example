# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=your_mongodb_connection_string

# Auth — must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret

# Allowed browser origins. Accepts a comma-separated list, so preview and
# staging deployments can be permitted alongside production:
#   CLIENT_URL=https://app.example.com,https://staging.example.com
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the app, used to resolve the real client
# IP for rate limiting. 1 is correct for Render/Railway/Fly; use 0 with no proxy.
TRUST_PROXY_HOPS=1

# Logging: error | warn | info | debug
LOG_LEVEL=info

# Optional — AI decision summaries are skipped when absent
GEMINI_API_KEY=your_google_gemini_api_key
